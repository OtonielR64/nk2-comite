Options -Indexes
DirectoryIndex index.html

# MIME types explícitos
AddType application/javascript .js
AddType text/css .css

RewriteEngine On

# /activos/ — detener TODO reescritura (END cancela también reglas del servidor)
RewriteCond %{REQUEST_URI} ^/activos/ [NC]
RewriteRule ^ - [END]

# /API/ — igual
RewriteCond %{REQUEST_URI} ^/API/ [NC]
RewriteRule ^ - [END]

# React Router: solo redirigir si el archivo/directorio no existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]

# index.html: nunca cachear
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set X-LiteSpeed-Cache-Control "no-cache"
  Header unset ETag
  FileETag None
</FilesMatch>

# Assets: cachear 1 año
<FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|ico)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
