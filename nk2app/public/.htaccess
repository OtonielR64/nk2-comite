Options -Indexes
RewriteEngine On

# Redirigir peticiones /api/ al backend PHP
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ - [L]

# Para React Router: todas las rutas no existentes → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# index.html: nunca cachear (siempre pedir versión fresca al servidor)
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header unset ETag
  FileETag None
</FilesMatch>

# Assets con hash en el nombre: cachear 1 año (el hash cambia con cada deploy)
<FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
