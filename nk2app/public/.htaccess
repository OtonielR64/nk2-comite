Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Archivos estáticos (JS/CSS/imágenes) — servir directamente sin redirigir
RewriteCond %{REQUEST_URI} ^/activos/ [NC]
RewriteRule ^ - [L]

# Redirigir peticiones /api/ al backend PHP
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ - [L]

# Para React Router: todas las rutas no existentes → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]

# index.html: nunca cachear (browser ni LiteSpeed)
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set X-LiteSpeed-Cache-Control "no-cache"
  Header unset ETag
  FileETag None
</FilesMatch>

# Assets con hash en el nombre: cachear 1 año (sin immutable para permitir revalidación)
<FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|ico)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
